# FitList — Environment variables
#
# Copy this file to `.env.local` and fill in real values. NEVER commit `.env.local`.
# Variables prefixed with NEXT_PUBLIC_ are inlined into the client bundle —
# anything sensitive must NOT use that prefix (see SUPABASE_SERVICE_ROLE_KEY,
# LLM_API_KEY, FIRECRAWL_API_KEY below).

# --- Supabase (Phase 0.4 / Phase 2 onward) ---

# Project URL from Supabase dashboard → Settings → API.
# Safe to expose to the browser; used by both the server and browser clients.
NEXT_PUBLIC_SUPABASE_URL=

# Public "anon" API key from Supabase dashboard → Settings → API.
# Safe to expose; all access is gated by Row Level Security policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — BYPASSES RLS. Server-only.
# Used by privileged API routes / cron jobs (e.g. nightly scrape refresh).
# Never ship this to the client and never log it.
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM (Phase 4: nutrition engine) ---

# API key for the chosen LLM provider. Server-side only.
LLM_API_KEY=

# Which provider to call. One of: anthropic | openai | gemini
LLM_PROVIDER=anthropic

# --- Scraping (Phase 5) ---

# Firecrawl API key for JS-rendered scraping of supermarket sites.
# Free tier is enough for early development. Server-side only.
FIRECRAWL_API_KEY=

# Bearer token for POST /api/scrape used during local/manual runs.
# Generate with:
#   node -e "console.log('scrape_dev_'+require('crypto').randomBytes(16).toString('hex'))"
# Server-only.
SCRAPE_SECRET=

# Bearer token Vercel Cron sends to /api/scrape on the nightly schedule.
# Vercel auto-injects the value as `Authorization: Bearer ${CRON_SECRET}` when
# this var is set on the project. Generate with the same one-liner as above
# and load into Vercel env vars (Production + Preview). Server-only.
CRON_SECRET=

# --- Mercado Pago (Phase 10: subscriptions) ---

# Access Token from MP dashboard → Tus integraciones → app → Credenciales.
# SANDBOX ONLY: always the TEST-... value. This project never uses production
# credentials / real money. Authorizes charges — server-side only, never ship
# to the client and never log it.
MP_ACCESS_TOKEN=

# Webhook signing secret ("Clave secreta"), generated in the MP dashboard when
# you save the webhook config. Validates the x-signature header. Server-only.
MP_WEBHOOK_SECRET=

# Public base URL of the app — used for the subscription back_url and the webhook
# notification_url. MUST be a public HTTPS URL for webhooks to fire (use the
# Vercel preview/prod URL; localhost needs an ngrok tunnel).
NEXT_PUBLIC_APP_URL=

# Sandbox testing: forces the subscription payer_email to your TEST BUYER's
# REAL email (format test_user_xxxxxxxx@testuser.com — get it by logging into
# mercadopago.com.ar as the test buyer → profile). A real email triggers "una
# de las partes es de prueba" at PAYMENT; the generic test@testuser.com is
# rejected at CREATION. Use the buyer's actual test email. Sandbox-only.
MP_TEST_PAYER_EMAIL=

# (Future) MP public key — ONLY needed if we ever add an embedded card form
# (Bricks). Not used by the redirect (init_point) flow. Safe to expose.
# MP_PUBLIC_KEY=
